# Database
DATABASE_URL="postgresql://aqar:aqar_secret@localhost:5432/aqar_elite?schema=public"

# Auth
SESSION_SECRET="change-this-to-a-random-secret-in-production-at-least-32-chars"
SESSION_MAX_AGE_SECONDS=86400

# Rate Limiting & Proxy
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
TRUST_PROXY=false

# Cookies (set true in HTTPS production; false only for local HTTP Docker evaluation)
COOKIE_SECURE=false

# App
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="عقار اليت"
